#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
jar=doclet/.dev/artifacts/jar/elide-doclet/elide-doclet.jar
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

echo '/** Example API. */ public class Example {}' > "$work/Example.java"
javadoc -quiet -d "$work/docs" -doclet dev.elide.doclet.ElideDoclet \
    -docletpath "$jar" "$work/Example.java"
test -s "$work/docs/index.html"
grep -Fq 'Example API.' "$work/docs/default-package/Example.md"
test -s "$work/docs/api.json"
test -s "$work/docs/assets/apidocs.css"
test -s "$work/docs/assets/apidocs.js"

mkdir "$work/guides"
printf '# Usage\n\nSee [missing](api/example.Missing).\n' > "$work/guides/usage.md"
if javadoc -quiet -d "$work/invalid" -doclet dev.elide.doclet.ElideDoclet -docletpath "$jar" \
    --guides "$work/guides" "$work/Example.java" >"$work/diagnostics" 2>&1; then
  echo "Expected an unknown guide reference to fail the build" >&2
  exit 1
fi
grep -Fq 'usage.md: Unknown API reference example.Missing' "$work/diagnostics"

javadoc -quiet -d "$work/model" --model-only --js-runtime "$work/no-runtime" \
    -doclet dev.elide.doclet.ElideDoclet -docletpath "$jar" "$work/Example.java"
test "$(ls "$work/model")" = api.json

+/** Short, bounded discovery cues from the same contracts as the full declarations. */
+export function contractRows(type: Type): string[] {
+  const rows = (type.components ?? []).map(p => p.name + ": " + blockText(p.doc));
+  const members = [...(type.members ?? [])].sort((a, b) => Number(!!b.source) - Number(!!a.source));
+  for (const m of members) {
+    if (rows.length >= 8) break;
+    if (m.implicit) continue;
+    const summary = summaryText(m.doc);
+    const returns = blockText(m.returns?.doc);
+    const facts = [
+      m.deprecated && ("Deprecated. " + blockText(m.deprecated.doc)),
+      summary,
+      returns && returns !== summary && ("Returns " + returns),
+      ...(m.throws ?? []).map(t => "Throws " + tokenText(t.type) + " " + blockText(t.doc)),
+    ].filter(Boolean);
+    if (facts.length) rows.push(memberTitle(m) + ": " + facts.join(" "));
+  }
+  return rows.slice(0, 8).map(row => row.replace(/\s+/g, " ").trim().slice(0, 220));
+}

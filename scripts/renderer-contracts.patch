+// Streamable member lookups for clients that need only one declaration or contract.
+import type { Member, Type } from "./model";
+import { INDEX, resolve, type Site, tokenText } from "./site";
+import { blockText, summaryText } from "./structure";
+
+export function declarationContracts(site: Site): string {
+  const lines: string[] = [];
+  function declaration(m: Member | Type) {
+    const href = resolve(site, INDEX, ".html", m.id);
+    if (!href) return;
+    const summary = summaryText(m.doc);
+    // Include short supplementary prose when the summary omits a condition or guarantee.
+    const prose = blockText(m.doc?.body).replace(/\s+/g, " ").trim();
+    const details = prose.startsWith(summary) ? prose.slice(summary.length).trim() : prose;
+    return {
+      href, name: m.name, kind: m.kind, signature: tokenText(m.signature),
+      summary: summary || undefined, details: details && details.length <= 512 ? details : undefined,
+      deprecated: m.deprecated && { since: m.deprecated.since, doc: blockText(m.deprecated.doc) || undefined },
+    };
+  }
+  function add(m: Member) {
+    const header = declaration(m);
+    if (!header) return;
+    lines.push(JSON.stringify({
+      ...header,
+      params: m.params?.length ? m.params.map(p => ({
+        name: p.name, type: tokenText(p.type), doc: blockText(p.doc) || undefined,
+      })) : undefined,
+      returns: m.returns && { type: tokenText(m.returns.type), doc: blockText(m.returns.doc) || undefined },
+      throws: m.throws?.length ? m.throws.map(t => ({
+        type: tokenText(t.type), doc: blockText(t.doc) || undefined,
+      })) : undefined,
+      value: m.constant, defaultValue: m.defaultValue,
+    }));
+  }
+  for (const pkg of site.packages) {
+    for (const m of [...pkg.functions ?? [], ...pkg.properties ?? []]) add(m);
+    for (const type of pkg.types ?? []) {
+      const header = declaration(type);
+      if (header) lines.push(JSON.stringify(header));
+      for (const m of type.members ?? []) add(m);
+    }
+  }
+  return lines.length ? lines.join("\n") + "\n" : "";
+}

+/** Short, bounded discovery cues from the same contracts as the full declarations. */
+export function contractRows(type: Type, format: "plain" | "markdown" = "plain"): string[] {
+  function row(label: string, facts: string, anchor?: string): string {
+    const text = (label + ": " + facts).replace(/\s+/g, " ").trim().slice(0, 220);
+    if (format === "plain") return text;
+    if (!anchor) return esc(text);
+    const title = label.replace(/\s+/g, " ").trim().slice(0, 220);
+    return `[${codeSpan(title)}](${dest("#" + fragment(anchor))})${esc(text.slice(title.length))}`;
+  }
+  const rows = (type.components ?? []).slice(0, 8).map(p => row(p.name, blockText(p.doc)));
+  const members = [...(type.members ?? [])].sort((a, b) => Number(!!b.source) - Number(!!a.source));
+  for (const m of members) {
+    if (rows.length >= 8) break;
+    if (m.implicit) continue;
+    const summary = summaryText(m.doc);
+    const returns = blockText(m.returns?.doc);
+    const facts = [
+      m.deprecated && ("Deprecated. " + blockText(m.deprecated.doc)),
+      summary,
+      returns && returns !== summary && ("Returns: " + returns),
+      ...(m.throws ?? []).map(t => "Throws: " + tokenText(t.type) + (t.doc?.length ? " - " + blockText(t.doc) : "")),
+    ].filter(Boolean);
+    if (facts.length) rows.push(row(memberTitle(m), facts.join(" "), m.anchor));
+  }
+  return rows;
+}

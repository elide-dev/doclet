#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

case "${1:-all}" in
  gradle|maven|all) consumer=${1:-all} ;;
  *) echo "Usage: $0 [gradle|maven|all]" >&2; exit 2 ;;
esac

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp -R tests/consumer/. "$work/"
mv "$work/theme.json" "$work/site theme.json"
version=$(sed -n 's/^version = "\([^"]*\)".*/\1/p' doclet/elide.pkl)
mkdir -p "$work/repository"
for member in doclet gradle-plugin maven-plugin; do
  cp -R "$member/.dev/staging/publish/maven/." "$work/repository/"
done

check_docs() {
  local page="$1/example/Example.html"
  grep -Fq 'Demonstrates the published doclet.' "$page"
  python3 - "$1/api.json" <<'PYTHON'
import json, sys
with open(sys.argv[1]) as source:
    model = json.load(source)
assert model["schema"] == "apidocs/1"
assert model["module"] == {"name": "doclet-consumer", "version": "1", "languages": ["java"]}
package, = model["packages"]
example, = package["types"]
assert package["name"] == "example" and example["id"] == "example.Example"
method = next(m for m in example["members"] if m["name"] == "find")
long_method = next(m for m in example["members"] if m["name"] == "selectBooksForCollection")
assert any("\n" in t["text"] for t in long_method["signature"]), long_method["signature"]
assert method["id"] == "example.Example#find(java.lang.String)"
assert method["doc"]["summary"][0]["text"] == "Finds a book by title."
assert method["params"][0]["name"] == "title"
PYTHON
  grep -Fq 'assets/apidocs.css' "$page"
  grep -Fq 'Finds a book by title.' "$1/example/Example.md"
  test -s "$1/assets/search-index.js"
  test -s "$1/llms.txt"
}

check_brand() {
  grep -Fq 'Field Guide SDK' "$1/index.html"
  grep -Fq '../example/Example.html#find(java.lang.String)' "$1/guides/lookup.html"
  grep -Fq 'Look up a book' "$1/example/Example.md"
  python3 - "$1/api.json" <<'PYTHON'
import json, sys
model = json.load(open(sys.argv[1]))
guide, = model["module"]["guides"]
assert guide["id"] == "guide:lookup"
example, = model["packages"][0]["types"]
assert len([entry for entry in example["doc"]["see"] if entry[0]["target"]["id"] == guide["id"]]) == 1
long_method = next(m for m in example["members"] if m["name"] == "selectBooksForCollection")
assert all("\n" not in t["text"] for t in long_method["signature"])
PYTHON
  grep -Fq '#345b84'  "$1/assets/theme.css"
}

if [[ "$consumer" != maven ]]; then
  gradle_args=(-p "$work" --console=plain -PdocletVersion="$version")
  gradle "${gradle_args[@]}" javadoc
  check_docs "$work/build/docs/javadoc"
  gradle "${gradle_args[@]}" "-PelideDoclet.theme=site theme.json" \
    -PelideDoclet.guides=guides -PelideDoclet.signatureFormatter=none -PelideDoclet.problems=warning,reference=error javadoc
  check_brand "$work/build/docs/javadoc"
fi

if [[ "$consumer" != gradle ]]; then
  m2="${DOCLET_TEST_M2:-$PWD/.dev/consumer-m2}"
  mkdir -p "$m2"
  cp -R "$work/repository/." "$m2/"
  mvn_args=(-B -q -f "$work/pom.xml" -Dmaven.repo.local="$m2" -Ddoclet.version="$version")
  mvn "${mvn_args[@]}" elide-doclet:javadoc
  check_docs "$work/target/reports/apidocs"
  mvn "${mvn_args[@]}" -DelideDoclet.theme="$work/site theme.json" \
    -DelideDoclet.guides="$work/guides" -DelideDoclet.signatureFormatter=none -DelideDoclet.problems=warning,reference=error elide-doclet:javadoc
  check_brand "$work/target/reports/apidocs"
fi

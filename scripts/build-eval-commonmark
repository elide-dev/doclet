#!/usr/bin/env bash
# Build both sides of the frozen CommonMark holdout from a locally cached sources JAR.
set -euo pipefail
cd "$(dirname "$0")/.."
coordinate=org/commonmark/commonmark/0.32.0/commonmark-0.32.0-sources.jar
archive=${1:-"${HOME}/.m2/repository/$coordinate"}
target="$PWD/.dev/eval-commonmark"
mkdir -p "$target"
work=$(mktemp -d "$target/.build.XXXXXXXX")
trap 'rm -rf "$work"' EXIT

python3 - "$archive" "$work/source" <<'PY'
import hashlib
from pathlib import Path
import sys
import zipfile

path, destination = map(Path, sys.argv[1:])
if not path.is_file():
    sys.exit(f"Missing {path}. Pass the local Maven Central CommonMark 0.32.0 sources JAR as argument.")
digest = hashlib.sha256(path.read_bytes()).hexdigest()
if digest != "064dcdef29a6c627d699c08e2bb1275fbf73af707d0ce6c9e95d56497b505412":
    sys.exit(f"Unexpected CommonMark source archive SHA-256: {digest}")
with zipfile.ZipFile(path) as archive:
    for name in archive.namelist():
        if name.startswith("org/commonmark/") and name.endswith(".java"):
            archive.extract(name, destination)
PY

elide build elide-doclet
doclet="$PWD/doclet/.dev/artifacts/jar/elide-doclet/elide-doclet.jar"
javadoc="${JAVA_HOME:+$JAVA_HOME/bin/}javadoc"
common=(-quiet -public -encoding UTF-8 -sourcepath "$work/source")
packages=(org.commonmark org.commonmark.node org.commonmark.parser org.commonmark.parser.beta
  org.commonmark.parser.block org.commonmark.parser.delimiter org.commonmark.renderer
  org.commonmark.renderer.html org.commonmark.renderer.markdown org.commonmark.renderer.text
  org.commonmark.text)
"$javadoc" "${common[@]}" -Xdoclint:none -notimestamp --no-platform-links \
  -d "$work/javadoc" "${packages[@]}"
"$javadoc" "${common[@]}" -doclet dev.elide.doclet.ElideDoclet -docletpath "$doclet" \
  --module-name commonmark --module-version 0.32.0 -d "$work/markdown" "${packages[@]}"
for format in javadoc markdown; do
  mkdir -p "$target/$format"
  rsync -a --delete "$work/$format/" "$target/$format/"
done

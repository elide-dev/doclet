amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"

steps {
  ["java-format"] {
    glob = "**/*.java"
    check = "elide javaformat -- --dry-run {{ files }}"
    fix = "elide javaformat -- {{ files }}"
  }
  ["kotlin-format"] {
    glob = List("**/*.kt", "**/*.kts")
    check = "elide ktfmt -- --google-style --dry-run {{ files }}"
    fix = "elide ktfmt -- --google-style {{ files }}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = true
    stage = true
    steps = module.steps
  }
}

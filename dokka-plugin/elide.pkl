amends "elide:project.pkl"

import "elide:Jvm.pkl" as Jvm

name = "elide-doclet-dokka-plugin"
version = "0.1.0" // x-release-please-version
local core = project("elide-doclet")

jvm { java { release = 17 } }
artifacts {
  ["elide-doclet-dokka-plugin"] = new Jvm.Jar {}
}
dependencies {
  maven {
    packages { core }
    compileOnly {
      "org.jetbrains.dokka:dokka-core:2.3.0"
      "org.jetbrains.dokka:dokka-base:2.3.0"
      "org.jetbrains.dokka:analysis-kotlin-symbols:2.3.0"
    }
  }
}

amends "elide:project.pkl"

import "elide:Jvm.pkl" as Jvm

name = "elide-doclet-gradle-plugin"
version = "0.4.0" // x-release-please-version
local core = project("elide-doclet")

jvm { java { release = 17 } }

artifacts {
  ["elide-doclet-gradle-plugin"] = new Jvm.Jar {}
}

dependencies {
  maven {
    packages { core }
    compileOnly { "dev.gradleplugins:gradle-api:8.11.1" }
  }
}

// Gradle resolves this marker coordinate for plugins { id("dev.elide.doclet") }.
publishing {
  maven {
    groupId = "dev.elide.doclet"
    artifactId = "dev.elide.doclet.gradle.plugin"
  }
}

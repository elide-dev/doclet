<plugin>
  <name>Elide Doclet Maven Plugin</name>
  <description>Generate API documentation with the Elide doclet.</description>
  <groupId>dev.elide</groupId>
  <artifactId>elide-doclet-maven-plugin</artifactId>
  <version>0.4.0</version><!-- x-release-please-version -->
  <goalPrefix>elide-doclet</goalPrefix>
  <mojos>
    <mojo>
      <goal>javadoc</goal>
      <description>Generate API documentation using the project's Javadoc configuration.</description>
      <requiresDependencyResolution>compile</requiresDependencyResolution>
      <requiresProject>true</requiresProject>
      <phase>prepare-package</phase>
      <implementation>dev.elide.doclet.DocletMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <parameters>
        <parameter><name>guides</name><type>java.io.File</type><required>false</required><editable>true</editable><description>Directory of Markdown guide pages.</description></parameter>
        <parameter><name>signatureFormatter</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Elide executable for signature layout, or none.</description></parameter>
        <parameter><name>theme</name><type>java.io.File</type><required>false</required><editable>true</editable><description>Optional renderer theme JSON file.</description></parameter>
        <parameter><name>problems</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>How to report comments the API model cannot represent: error (default) or warning, optionally per category, such as error,inheritdoc=warning.</description></parameter>
        <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable></parameter>
        <parameter><name>session</name><type>org.apache.maven.execution.MavenSession</type><required>true</required><editable>false</editable></parameter>
      </parameters>
      <configuration>
        <guides implementation="java.io.File">${elideDoclet.guides}</guides>
        <signatureFormatter implementation="java.lang.String">${elideDoclet.signatureFormatter}</signatureFormatter>
        <theme implementation="java.io.File">${elideDoclet.theme}</theme>
        <problems implementation="java.lang.String">${elideDoclet.problems}</problems>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <session implementation="org.apache.maven.execution.MavenSession" default-value="${session}"/>
      </configuration>
      <requirements>
        <requirement><role>org.apache.maven.plugin.BuildPluginManager</role><field-name>pluginManager</field-name></requirement>
      </requirements>
    </mojo>
  </mojos>
</plugin>
